{
    "name": "git-subbridge",
    "version": "1.0.7",
    "description": "Adds a custom Git bridge for committing nested repositories in a vault.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs dev",
        "build": "node esbuild.config.mjs production",
        "release": "standard-version",
        "lint": "eslint src tests vitest.config.ts",
        "format": "prettier --check src tests vitest.config.ts",
        "tsc": "tsc --noEmit",
        "svelte": "svelte-check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "all": "pnpm run tsc && pnpm run svelte && pnpm run format && pnpm run lint && pnpm run test"
    },
    "keywords": [],
    "author": "一只朱 <zhujiejava1@gmail.com> (https://github.com/zhu1j)",
    "license": "MIT",
    "type": "module",
    "standard-version": {
        "t": ""
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/debug": "^4.1.13",
        "@types/diff3": "^0.0.2",
        "@types/node": "^26.6.5",
        "@typescript-eslint/parser": "8.71.2",
        "@vitest/coverage-v8": "^5.0.4",
        "esbuild": "^0.28.2",
        "esbuild-svelte": "^0.9.5",
        "eslint": "^10.12.0",
        "eslint-plugin-svelte": "^3.23.1",
        "obsidian": "^1.14.4",
        "prettier": "3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "scss": "^0.2.4",
        "standard-version": "^9.5.0",
        "svelte-check": "^4.7.6",
        "svelte-eslint-parser": "^1.9.0",
        "svelte-preprocess": "^6.0.5",
        "tslib": "^2.8.1",
        "typescript": "7.0.2",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/merge": "^6.12.2",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "buffer": "^6.0.3",
        "codemirror": "^6.0.2",
        "css-color-converter": "^2.0.0",
        "debug": "^4.4.3",
        "diff": "^9.0.0",
        "diff2html": "^3.4.56",
        "diff3": "^0.0.4",
        "isomorphic-git": "1.44.2",
        "js-sha256": "^1.0.0",
        "simple-git": "^4.0.2",
        "svelte": "^5.57.2"
    },
    "moduleFileExtensions": [
        "js",
        "ts",
        "svelte"
    ],
    "repository": "https://github.com/zhu1j/git-subbridge.git",
    "homepage": "https://github.com/zhu1j/git-subbridge#readme",
    "bugs": "https://github.com/zhu1j/git-subbridge/issues"
}
